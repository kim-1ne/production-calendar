{
    "name": "kim-1ne/production-calendar",
    "description": "PHP library for working with Russian production calendar",
    "autoload": {
        "psr-4": {
            "Kim1ne\\ProductionCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kim1ne\\ProductionCalendar\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "kim-1ne"
        }
    ],
    "require": {
        "symfony/var-dumper": "^7.4",
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "type": "library",
    "license": "MIT"
}
